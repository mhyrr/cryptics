 "chapter_headings": {
  "1": "Liber Quartus! Cap: 1. Alle Vergangene und Künftige Dinge, so nicht wieder Gott und seinen Willen zu wissen.",
  "2": "Lib IV Cap 2. Gericht auff aller hand zweiffelhaffte Sachen zu haben.",
  "3": "Lib: IV. Cap 3. Einen jeden Geist erscheinen machen.",
  "4": "Lib: IV. Cap: 4. allerley gesichte zu haben.",
  "5": "Lib: IV. Cap 5. Dienst=Geister zu bekomen, Lötig oder verschloßen, auch wieder weg zu schicken.",
  "6": "Lib: IV. Cap: 6. aller ley Bergwerck arbeit durch die Geister verrichten zu laßen.",
  "7": "Lib: IV: Cap 7. allerley Alchimi„ stische arbeiten durch die Geister zu verrichten.",
  "8": "Lib. IV. Cap: 8. Wetter zu ma„ chen.",
  "9": "Lib. IV. Cap: 9. Leüte in Vieh, und Vieh in Leüte zu verwandeln.",
  "10": "Lib. IV. Cap: 10. alle andere Magos zu [vernichten/verrichten] und abzu thun.",
  "11": "Lib: IV: Cap: 11. allerley verlohrne Schrifften und bücher wie auch verborgene Schrifften und Sachen zu bekommen.",
  "12": "Lib: IV: Cap: 12. allerley verborgene anschläge und vor„ haben einer Person zu erkundigen.",
  "13": "Lib: IV: Cap: 13. Einen Todten leich„ namb 7. Jahr lang für lebendig herumb zu gehen machen, daß er alles thut und redet, als wenn er lebet!",
  "14": "Lib: IV: Cap: 14.",
  "15": "Lib: IV Cap: 15. Daß die Geister al„ lerley Sachen, so zu erdencken von Eßen und trincken bringen.",
  "16": "Lib: IV: Cap: 16. allerley Schätze zu Geben.",
  "17": "Lib: IV: Cap: 17. In der lufft zu fah„ ren.",
  "18": "Lib: IV: Cap: 18. allerley Kranckhei„ ten zu heilen.",
  "19": "Lib: IV. Cap: 19. Zu allerley Freund„ schafft.",
  "20": "Lib:IV. Cap:20. Zu allerhandt Feindtschafft.",
  "21": "Lib. IV. Cap 21. Sich selbst in mancherley gestalt verwandeln.",
  "22": "Lib:IV. Cap.22. Leüte Kinder und Vieh zu er[k/t]räncken.",
  "23": "Lib.IV. Cap 23. Häuser und Gemächer einzuwerfen.",
  "24": "Lib.IV. Cap.24. Bestohlen guth wieder zu bringen.",
  "25": "Lib:IV. Cap:25. So lange der Mensch will unter dem Wasser zu wandeln.",
  "26": "Lib:IV. Cap:26. Allerhandt versperrende Sachen auffzusperren, und ohne Schlüßel wieder zu machen.",
  "27": "Lib IV: Cap 27. Allerley Dinge als Schlößer, Palläste, Häuser, gärthen, Städte, Thiere, Vögel, und in summa, was nicht gegenwärtig erscheinent machen.",
  "28": "Lib IV. Cap:28. Gold und Silber=Müntzen in allen Nöthen zu haben so viel man immer bedürfftig ist.",
  "29": "Lib:IV: Cap:29. allerley Kriegesvolck und Krieges Rüstunge erscheinend machen.",
  "30": "Lib:IV: Cap 30. allerley Music und gauckel=Spiel durch die Geister anrichten."
 },
