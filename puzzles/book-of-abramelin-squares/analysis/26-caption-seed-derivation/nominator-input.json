   "chapter": 6,
   "heading": "Lib: IV. Cap: 6. aller ley Bergwerck arbeit durch die Geister verrichten zu laßen.",
   "items": [
    {
     "key": "p247-c3-g1",
     "item": 1,
     "caption": "1. Daß kein Schacht im Bergwerck ein„ falle."
    },
    {
     "key": "p247-c3-g2",
     "item": 2,
     "caption": "2. Wo ein gold oder Silber gang, daß sol„ ches die Geister zei„ gen müßen."
    },
    {
     "key": "p248-c1-g1",
     "item": 3,
     "caption": "3. Daß die Geister das Ertz aus den ber„ gen hauen, da sonst kein Mensch hin kan."
    },
    {
     "key": "p248-c1-g2",
     "item": 4,
     "caption": "4. Daß Geister gan„ ze berge durchhauen„"
    },
    {
     "key": "p248-c1-g3",
     "item": 5,
     "caption": "5. Daß die Geister das Waßer aus den Schäch„ ten abführen."
    },
    {
     "key": "p248-c2-g1",
     "item": 6,
     "caption": "6. Daß die Geister Holtz zum Schmel„ zen herzu bringen."
    },
    {
     "key": "p248-c2-g2",
     "item": 7,
     "caption": "7. Daß die Geister das Ertz seigern."
    },
    {
     "key": "p248-c2-g3",
     "item": 8,
     "caption": "8. Sonsten allerhand bergarbeit zu ver„ richten."
    }
